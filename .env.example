# Example environment settings for the forecasting pipeline
# Copy this file to .env and populate values as needed.

DEVICE=cpu
MODEL_NAME=NeoQuasar/Kronos-small
TOKENIZER_NAME=NeoQuasar/Kronos-Tokenizer-base
DATA_PROVIDER=yfinance
LOOKBACK=400
PREDICTION_HORIZON=10
TEMPERATURE=1.0
TOP_P=0.9
SAMPLE_COUNT=1
DIRECTION_THRESHOLD=1.5
